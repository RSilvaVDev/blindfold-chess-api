# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# Origins allowed to call the API from a browser, comma-separated, no trailing slash.
# Local: the Vite dev server. Railway: the web service's public URL.
CORS_ORIGIN=http://localhost:5173

# Supabase "Server" connection method, read by @supabase/server
# (Project Settings > API Keys). Use the new keys, never the legacy anon/service_role keys.
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...). Safe to expose; the web app uses the same key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key (sb_secret_...). Server-only: Storage uploads for cached audio.
SUPABASE_SECRET_KEY=sb_secret_...
# Public signing keys used to verify user JWTs (ES256). Optional: when unset it is
# derived from SUPABASE_URL as {SUPABASE_URL}/auth/v1/.well-known/jwks.json.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Supabase Postgres for Prisma (Connect > Session pooler, port 5432). The
# "Server" keys above do not cover database access through Prisma. The direct
# db.<ref>.supabase.co host is IPv6-only on the free plan, so use the pooler;
# the same string serves the app and migrations.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
