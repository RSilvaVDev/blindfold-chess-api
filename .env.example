# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# Origins allowed to call the API from a browser, comma-separated, no trailing slash.
# Local: the Vite dev server. Railway: the web service's public URL.
CORS_ORIGIN=http://localhost:5173

# Supabase Postgres (Project Settings > Database > Connection string).
# Pooled: transaction pooler, port 6543, used by the running app.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct: port 5432, used only by migrations.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
